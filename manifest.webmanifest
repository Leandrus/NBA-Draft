{
  "id": "https://nba.leandrus.net/",
  "name": "Ultimate Draft - Simulador NBA",
  "short_name": "Ultimate Draft",
  "description": "Simulador competitivo de baloncesto para dos jugadores locales con draft de cartas y 1,000 jugadores reales de la NBA.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#020b13",
  "theme_color": "#020b13",
  "icons": [
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "favicon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "icons/basketball.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "categories": [
    "games",
    "sports",
    "entertainment"
  ],
  "shortcuts": [
    {
      "name": "Modo Normal",
      "url": "/?mode=normal",
      "description": "Iniciar Draft clásico con cartas ocultas y scout"
    },
    {
      "name": "Duelo 3x3",
      "url": "/?mode=3x3",
      "description": "Partidos rápidos 3x3 de media cancha"
    },
    {
      "name": "Las Finales",
      "url": "/?mode=finales",
      "description": "Serie al mejor de 7 partidos"
    }
  ]
}
